# ======================= Required =======================
PINECONE_API_KEY=
OPENAI_API_KEY=
# Long random string; keeps sessions (and chat history ownership) valid across restarts.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ======================= Accounts =======================
# Comma-separated emails that get the /admin dashboard after they sign up / log in.
# ADMIN_EMAILS=you@example.com
# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI  <PUBLIC_BASE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://medibot.example.com

# ======================= Server =======================
# HOST=127.0.0.1                 # 0.0.0.0 to accept connections from other machines
# PORT=8080
# THREADS=8
# FLASK_DEBUG=false
# SESSION_COOKIE_SECURE=true     # when served over HTTPS
# TRUSTED_PROXIES=1              # when behind nginx / a load balancer

# ======================= Storage & scaling =======================
# DATABASE_URL=sqlite:///instance/chat.db    # e.g. postgresql+psycopg://user:pass@host/medibot
# RATELIMIT_STORAGE_URI=memory://            # e.g. redis://localhost:6379/0 for several instances
# RATELIMIT_CHAT=10 per minute;100 per day
# RATELIMIT_UPLOAD=3 per minute;20 per day
# RATELIMIT_AUTH=10 per minute;50 per hour

# ======================= AI =======================
# PINECONE_INDEX=medical-chatbot-v2
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # must match the model used by store-index.py
# OPENAI_MODEL=gpt-4o
# REWRITE_MODEL=gpt-4o-mini                 # rewrites follow-up / Urdu questions into search queries
# RETRIEVER_K=4
# HYBRID_SEARCH=true                        # keyword (BM25) + vector search
# MODERATION_ENABLED=true
# ANSWER_CACHE_HOURS=168                    # 0 disables the answer cache
# PRICE_INPUT_PER_M=2.50                    # USD per 1M tokens, for the admin cost estimate
# PRICE_OUTPUT_PER_M=10.00

# ======================= Safety & monitoring =======================
# EMERGENCY_NUMBERS=Rescue (Pakistan):1122,Edhi Ambulance:115,Umang mental-health helpline:0311-7786264,International:112
# SENTRY_DSN=                               # error tracking (pip install sentry-sdk[flask])
